<div class="card shadow-lg border-0 hero-card">
  <div class="card-body p-5 text-center">
    <i class="bi bi-brush-fill display-4 text-brand"></i>
    <h1 class="h2 fw-bold mt-3">Drawboard</h1>
    <p class="text-muted mb-4">Pick a name and jump into a shared board.</p>

    <%= form_with url: session_path, class: "vstack gap-3" do %>
      <%= text_field_tag :name, nil,
            class: "form-control form-control-lg text-center",
            placeholder: "Your name",
            maxlength: 24, autofocus: true, required: true %>
      <%= submit_tag "Enter", class: "btn btn-brand btn-lg" %>
    <% end %>
  </div>
</div>
